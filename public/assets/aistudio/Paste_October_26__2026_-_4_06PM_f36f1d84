function scramble(el,txt,dur=520){
  if(RM){el.textContent=txt;return}
  if(el._txt===txt)return; el._txt=txt;
  const pool='ابپتثجچحخدذرزسشصضطظعغفقکگلمنوهی۰۱۲۳۴۵۶۷۸۹·—/';
  const t0=performance.now();
  cancelAnimationFrame(el._raf||0);
  (function step(){
    const k=Math.min(1,(performance.now()-t0)/dur);
    const lock=Math.floor(k*txt.length); let out='';
    for(let i=0;i<txt.length;i++){const c=txt[i];
      out+=(i<lock||c===' ')?c:pool[(Math.random()*pool.length)|0];}
    el.textContent=out;
    if(k<1)el._raf=requestAnimationFrame(step); else el.textContent=txt;
  })();
}
