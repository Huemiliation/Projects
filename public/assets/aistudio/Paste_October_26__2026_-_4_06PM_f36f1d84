    +'<filter id="bl" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="14"/></filter>'
    +'</defs>'
    +'<rect width="1000" height="640" fill="url(#bg)"/>'
    +'<ellipse cx="500" cy="60" rx="470" ry="230" fill="url(#sp)"/>'
    +'<ellipse cx="500" cy="560" rx="340" ry="26" fill="rgba(0,0,0,.5)" filter="url(#bl)"/>'
    +`<g transform="translate(${cx} ${cy}) scale(${k}) translate(${-cx} ${-cy})">${a}</g>`
    +`<line x1="240" y1="${ry}" x2="760" y2="${ry}" stroke="#8f8f88" stroke-width="1.2" opacity=".8"/>`
    +`<line x1="240" y1="${ry-6}" x2="240" y2="${ry+6}" stroke="#8f8f88"/>`
    +`<line x1="760" y1="${ry-6}" x2="760" y2="${ry+6}" stroke="#8f8f88"/>`
    +`<circle cx="500" cy="${ry}" r="3" fill="#d2a24c"/>`
    +`<text x="500" y="54" text-anchor="middle" font-family="Segoe UI,Tahoma" font-size="26" letter-spacing="2" fill="#ecd9a8">${u.latin}</text>`
    +`<text x="500" y="80" text-anchor="middle" font-family="Tahoma" font-size="14" fill="#8f8f88">${u.cls} · ${u.cat} · اوج‌نما</text>`
    +`<text x="500" y="586" text-anchor="middle" font-family="Tahoma" font-size="15" fill="#b9b4a8">${u.sizeType}: ${sizeFa(u)}</text>`
    +`<text x="500" y="630" text-anchor="middle" font-family="Tahoma" font-size="12" fill="#5f5f5a">پلیت برداری مقیاس‌دار — پشتیبان آفلاینِ عکس آرشیو</text>`
    +'</svg>';
  return 'data:image/svg+xml;charset=utf-8,'+encodeURIComponent(svg);
}

/* ═══════════ ۳) موتور تصویر: استخراج خودکار + زنجیرهٔ پشتیبان ═══════════ */
const imgKey=id=>'ojn4-img-'+id, galKey=id=>'ojn4-gal-'+id;
const filePathURL=(f,w)=>'https://commons.wikimedia.org/wiki/Special:FilePath/'+encodeURIComponent(f)+'?width='+(w||1400);
const loadImg=(url,ms)=>new Promise((res,rej)=>{
  const im=new Image(); let done=false;
  const ok=()=>{if(!done){done=true;res(url)}};
  const bad=()=>{if(!done){done=true;im.src='';rej(new Error('load'))}};
  im.onload=ok; im.onerror=bad; setTimeout(bad,ms||9000); im.decoding='async'; im.src=url;
});
async function wikiThumbs(title){
  const r=await fetch('https://en.wikipedia.org/api/rest_v1/page/summary/'+encodeURIComponent(title.replace(/ /g,'_')));
  if(!r.ok)throw new Error('http');
  const j=await r.json(), out=[];
  if(j.thumbnail&&j.thumbnail.source){
    out.push(j.thumbnail.source.replace(/\/\d+px-/,'/1280px-'));
    out.push(j.thumbnail.source);
  }
  if(j.originalimage&&j.originalimage.source)out.push(j.originalimage.source);
  return out;
}
async function resolveHero(u){
  const key=imgKey(u.id), c=cacheGet(key);
  if(c)return{url:c,net:!c.startsWith('data:')};
  const cand=[];
  if(navigator.onLine){
    for(const t of(u.wiki||[])){try{cand.push(...await wikiThumbs(t))}catch(e){}}
    for(const f of(u.files||[]))cand.push(filePathURL(f));
  }
  for(const url of cand){
    try{await loadImg(url);cacheSet(key,url);return{url,net:true}}catch(e){}
  }
  return{url:u._svg||(u._svg=svgSil(u)),net:false};
}
async function commonsGallery(u){
  const key=galKey(u.id), c=cacheGet(key);
  if(c){try{return JSON.parse(c)}catch(e){}}
  if(!navigator.onLine)throw new Error('offline');
  const url='https://commons.wikimedia.org/w/api.php?action=query&format=json&origin=*'
    +'&generator=search&gsrnamespace=6&gsrlimit=14'
    +'&gsrsearch='+encodeURIComponent(u.gq||u.latin)
    +'&prop=imageinfo&iiprop=url&iiurlwidth=1200';
  const r=await fetch(url);
  if(!r.ok)throw new Error('http');
  const j=await r.json();
  const pages=Object.values((j.query&&j.query.pages)||{});
  pages.sort((a,b)=>(a.index||0)-(b.index||0));
  const list=pages.map(p=>p.imageinfo&&p.imageinfo[0]&&p.imageinfo[0].thumburl)
    .filter(Boolean).filter(s=>/\.(jpe?g|png)$/i.test(s)).slice(0,8);
  if(list.length)cacheSet(key,JSON.stringify(list));
  return list;
}
function preheat(u){
  if(!navigator.onLine)return;
  const i=order.indexOf(u); if(i<0)return;
  [1,-1].forEach(d=>{
    const n=order[(i+d+order.length)%order.length];
    if(n&&!cacheGet(imgKey(n.id)))resolveHero(n).catch(()=>{});
  });
}

/* ═══════════ ۴) وضعیت برنامه ═══════════ */
let filter='all',query='',cur=null,mainShown=null,order=[];
let heroShow=0,bgShow=0;
const CATS=[['all','همه'],['شناسایی','شناسایی'],['رزمی','رزمی'],['انتحاری','انتحاری'],['تجاری','تجاری'],['نظارت','نظارت']];
const LOGMIN=Math.log10(0.15),LOGMAX=Math.log10(42);
const pos=s=>((Math.log10(s)-LOGMIN)/(LOGMAX-LOGMIN)*100).toFixed(2);
const matchQ=u=>{const q=query.trim().toLowerCase();if(!q)return true;
  return u.name.includes(query)||u.short.includes(query)||u.maker.includes(query)||u.latin.toLowerCase().includes(q);};

/* ═══════════ ۵) تصویر اصلی: کراس‌فید + پس‌زمینهٔ محو ═══════════ */
const fg=[$('fgA'),$('fgB')],bg=[$('bgA'),$('bgB')];
function setBg(url){
  const b=bg[bgShow^1],o=bg[bgShow];
  const go=()=>{b.style.opacity='1';o.style.opacity='0';bgShow^=1};
  if(b.src===url&&b.complete){go();return}
  b.onload=go; b.src=url;
}
function crossfade(u,url){
  const nxt=fg[heroShow^1],old=fg[heroShow];
  nxt.onerror=()=>{if(url.startsWith('data:'))return;crossfade(u,u._svg||(u._svg=svgSil(u)))};
  nxt.onload=()=>{
    nxt.style.opacity='1';old.style.opacity='0';
    nxt.classList.add('kb');old.classList.remove('kb');heroShow^=1;setBg(url);
  };
  if(nxt.src===url&&nxt.complete){nxt.onload();return}
  nxt.src=url;
}

/* ═══════════ ۶) کاروسل بندانگشتی (جایگزین گالری مدالی) ═══════════ */
let galList=[],galIdx=0,galTok=0,galPending=false;
function renderStrip(u){
  const s=$('galStrip'); s.innerHTML='';
  galList.forEach((it,i)=>{
    const b=document.createElement('button');
    b.className='thumb'+(i===galIdx?' on':'');
    b.title=it.cap;
    b.setAttribute('aria-label','تصویر '+faDigits(i+1));
    b.innerHTML=`<img loading="lazy" src="${it.src}" alt=""><span class="tno">${faDigits(i+1)}</span>`;
    b.addEventListener('click',()=>setMain(u,i));
    s.appendChild(b);
  });
  if(galPending){
    for(let i=0;i<u.gallery.length;i++){
      const d=document.createElement('div'); d.className='skelT'; s.appendChild(d);
    }
  }
  const act=s.children[galIdx];
  if(act&&act.scrollIntoView)act.scrollIntoView({behavior:RM?'auto':'smooth',inline:'center',block:'nearest'});
}
function syncGalHead(){
  const it=galList[galIdx];
  if(it)$('galCap').textContent=it.cap;
  $('galIdx').textContent=faDigits(galIdx+1)+' / '+faDigits(galList.length);
  $('imgNo').textContent=faDigits(galIdx+1)+' / '+faDigits(galList.length);
}
function setMain(u,i){
  galIdx=i; const it=galList[i]; if(!it)return;
  crossfade(u,it.src);
  syncGalHead();
  document.querySelectorAll('#galStrip .thumb').forEach((t,ti)=>t.classList.toggle('on',ti===i));
  const el=document.querySelectorAll('#galStrip .thumb')[i];
  if(el)el.scrollIntoView({behavior:RM?'auto':'smooth',inline:'center',block:'nearest'});
}
function galleryInit(u){
  const tok=++galTok;
  galIdx=0; galPending=true;
  const cached=cacheGet(imgKey(u.id));
  const svg=u._svg||(u._svg=svgSil(u));
  galList=[{src:cached||svg,cap:'نمای اصلی — '+(cached?'عکس آرشیوی ویکی‌مدیا':'پلیت برداری مقیاس‌دار'),net:!!cached}];
  renderStrip(u); syncGalHead(); setMain(u,0);
  /* ارتقای ناهمگام تصویر اصلی به بهترین عکس آرشیوی */
  resolveHero(u).then(r=>{
    if(tok!==galTok)return;
    if(r.net&&!cached){
      galList[0]={src:r.url,cap:'نمای اصلی — عکس آرشیوی ویکی‌مدیا',net:true};
      renderStrip(u); if(galIdx===0)setMain(u,0); else syncGalHead();
    }
    preheat(u);
  }).catch(()=>{});
  /* تصاویر عملیاتی از ویکی‌مدیا کامانز */
  commonsGallery(u).then(imgs=>{
    if(tok!==galTok)return;
    galPending=false;
    imgs.slice(0,8).forEach((src,i)=>galList.push({src,cap:u.gallery[i%u.gallery.length],net:true}));
    renderStrip(u); syncGalHead();
  }).catch(()=>{
    if(tok!==galTok)return;
    galPending=false; renderStrip(u); syncGalHead();
    if(galList.length===1)
      $('galCap').textContent='برای دریافت تصاویر عملیاتی، اتصال اینترنت لازم است — پلیت برداری نمایش داده می‌شود';
  });
}

/* ═══════════ ۷) تایم‌لاین مقیاس (محور لگاریتمی) ═══════════ */
function buildTicks(){
  const tc=$('ticks');tc.innerHTML='';
  if(!order.length){tc.innerHTML='<div class="emptyMsg">موردی با این فیلتر یافت نشد</div>';return}
  order.forEach((u,i)=>{
    const b=document.createElement('button');
    b.className='tick '+(i%2?'rB':'rA');
    b.dataset.id=u.id;
    b.style.right=pos(u.size)+'%';
    b.title=u.name+' · '+sizeEn(u);
    b.setAttribute('aria-label',u.name);
    b.innerHTML=`<span class="tdot"></span><span class="tlab"><b>${u.short}</b><i class="latin">${sizeEn(u)}</i></span>`;
    b.addEventListener('click',()=>goTo(u));
    tc.appendChild(b);
  });
}
function updateTicksActive(){
  document.querySelectorAll('#ticks .tick').forEach(t=>
    t.classList.toggle('active',!!cur&&t.dataset.id===cur.id));
}
function moveCursor(instant){
  const c=$('cursor');
  if(instant)c.classList.add('noT');
  if(cur)c.style.right=pos(cur.size)+'%';
  if(instant)requestAnimationFrame(()=>requestAnimationFrame(()=>c.classList.remove('noT')));
}

/* ═══════════ ۸) HUD و تحلیل عملیاتی ═══════════ */
function updateMeta(){
  const i=cur?order.indexOf(cur):-1;
  const s=i>=0?`${faDigits(i+1)} / ${faDigits(order.length)}`:'—';
  $('tlCount').textContent=s;$('hCount').textContent=s;
}
function fillList(id,arr){
  $(id).innerHTML=arr.map(x=>`<li>${x}</li>`).join('');
  flash($(id));
}
function hudUpdate(u){
  const i=order.indexOf(u);
  $('hIdx').textContent=i>=0?`صفحهٔ ${faDigits(i+1)} از ${faDigits(order.length)}`:'—';
  scramble($('hName'),u.name);flash($('hName'));
  $('hLatin').textContent=u.latin;flash($('hLatin'));
  $('hMakerTxt').textContent=u.maker;
  scramble($('hCat'),u.cat);scramble($('hCls'),u.cls);
  $('pCat').textContent=u.cat;$('pCls').textContent=u.cls;flash($('pCat'));
  $('hDesc').textContent=u.desc;flash($('hDesc'));
  countTo($('hRange'),u.range,900);countTo($('hSpeed'),u.speed,900);countTo($('hCeil'),u.ceiling,900);
  scramble($('hEnd'),u.enduranceLbl);scramble($('hWeight'),u.weight);
  scramble($('hEngine'),u.engine);scramble($('hDims'),u.dims);
  /* قیمت: ساده و غیرمحور — یک ردیف مشخصات معمولی */
  $('hPriceTxt').textContent=fmtPrice(u.price)+' · '+u.priceNote;
  /* بخش تحلیل عملیاتی */
  fillList('anaCaps',u.caps);fillList('anaPros',u.pros);fillList('anaCons',u.cons);
  $('plLatin').textContent=u.latin;flash($('plLatin'));
  $('plSize').textContent=`${u.sizeType} ${sizeFa(u)}`;flash($('plSize'));
  updateMeta();
}
function sync(instantCursor){
  if(!cur)return;
  if(cur.id!==mainShown){mainShown=cur.id;galleryInit(cur);hudUpdate(cur)}
  updateTicksActive();moveCursor(instantCursor);
}
function goTo(u){
  if(!u||!order.includes(u))return;
  cur=u;sync();
}
function nav(d){
  if(!order.length||!cur)return;
  goTo(order[(order.indexOf(cur)+d+order.length)%order.length]);
}

/* ═══════════ ۹) فیلتر و جست‌وجو ═══════════ */
function buildChips(){
  const c=$('chips');c.innerHTML='';
  CATS.forEach(p=>{
    const n=p[0]==='all'?UAVS.length:UAVS.filter(u=>u.cat===p[0]).length;
    const b=document.createElement('button');
    b.className='chipBtn'+(filter===p[0]?' on':'');
    b.innerHTML=`${p[1]}<i>${faDigits(n)}</i>`;
    b.addEventListener('click',()=>{filter=p[0];buildChips();refresh()});
    c.appendChild(b);
  });
}
function refresh(){
  order=UAVS.filter(u=>(filter==='all'||u.cat===filter)&&matchQ(u));
  if(cur&&!order.includes(cur))cur=null;
  if(!cur&&order.length)cur=order[0];
  buildTicks();sync(true);
  if($('catModal').classList.contains('open'))renderCatalog();
}

/* ═══════════ ۱۰) مدال فهرست موزه ═══════════ */
function renderCatalog(){
  const g=$('catGrid');g.innerHTML='';
  if(!order.length){g.innerHTML='<div class="emptyMsg" style="grid-column:1/-1;padding:40px 0">موردی یافت نشد</div>';return}
  order.forEach(u=>{
    const b=document.createElement('button');
    b.className='catCard';
    const src=cacheGet(imgKey(u.id))||u._svg||(u._svg=svgSil(u));
    b.innerHTML=`<img loading="lazy" src="${src}" alt="${u.name}">
      <div class="catBody">
        <div class="r1"><b>${u.name}</b><span class="chip">${u.cat}</span></div>
        <div class="r2 latin">${u.latin} · ${u.maker}</div>
        <div class="r3">${u.sizeType} ${sizeFa(u)} · کلاس ${u.cls}</div>
      </div>`;
    b.addEventListener('click',()=>{closeCatalog();goTo(u)});
    g.appendChild(b);
  });
}
function openCatalog(){renderCatalog();$('catModal').classList.add('open')}
function closeCatalog(){$('catModal').classList.remove('open')}
 $('catBtn').addEventListener('click',openCatalog);
 $('catClose').addEventListener('click',closeCatalog);
 $('catModal').addEventListener('click',e=>{if(e.target===$('catModal'))closeCatalog()});

/* ═══════════ ۱۱) لایت‌باکس (بزرگ‌نمایی تصویر فعال کاروسل) ═══════════ */
const lb=$('lightbox'),lbImg=$('lbImg');
let lbList=[],lbIdx=0;
function openLB(i){
  if(!cur||!galList.length)return;
  lbList=galList.slice(); lbIdx=Math.max(0,Math.min(i,lbList.length-1));
  lbShow(); lb.classList.add('open');
}
function closeLB(){lb.classList.remove('open')}
function lbShow(){
  const it=lbList[lbIdx];if(!it)return;
  lbImg.style.opacity='0';
  const pre=new Image();
  const done=()=>{
    lbImg.src=it.src;lbImg.alt=it.cap;
    $('lbCap').textContent=it.cap;
    $('lbCount').textContent=`${faDigits(lbIdx+1)} / ${faDigits(lbList.length)}`;
    requestAnimationFrame(()=>lbImg.style.opacity='1');
  };
  pre.onload=done;pre.onerror=done;pre.src=it.src;
  if(pre.complete)done();
}
function lbNav(d){if(!lbList.length)return;lbIdx=(lbIdx+d+lbList.length)%lbList.length;lbShow()}
 $('lbPrev').addEventListener('click',()=>lbNav(-1));
 $('lbNext').addEventListener('click',()=>lbNav(1));
 $('lbClose').addEventListener('click',closeLB);
lb.addEventListener('click',e=>{if(e.target===lb)closeLB()});

/* ═══════════ ۱۲) ورودی‌ها: کیبورد، سوایپ، تیلت، کاروسل ═══════════ */
addEventListener('keydown',e=>{
  const tag=(e.target.tagName||'').toLowerCase();
  if(tag==='input'){if(e.key==='Escape')e.target.blur();return}
  if(e.key==='Escape'){closeLB();closeCatalog();return}
  if(lb.classList.contains('open')){
    if(e.key==='ArrowLeft')lbNav(1);else if(e.key==='ArrowRight')lbNav(-1);
    return;
  }
  if(e.key==='ArrowLeft'||e.key==='ArrowDown')nav(1);
  else if(e.key==='ArrowRight'||e.key==='ArrowUp')nav(-1);
  else if(e.key.toLowerCase()==='g'){$('catModal').classList.contains('open')?closeCatalog():openCatalog()}
});
 $('nextBtn').addEventListener('click',()=>nav(1));
 $('prevBtn').addEventListener('click',()=>nav(-1));
 $('mNext').addEventListener('click',e=>{e.stopPropagation();nav(1)});
 $('mPrev').addEventListener('click',e=>{e.stopPropagation();nav(-1)});
 $('galNext').addEventListener('click',()=>{$('galStrip').scrollBy({left:-280,behavior:'smooth'})});
 $('galPrev').addEventListener('click',()=>{$('galStrip').scrollBy({left:280,behavior:'smooth'})});

const plate=$('plate');
let pDown=null,plateSwipe=false;
plate.addEventListener('pointerdown',e=>{pDown=[e.clientX,e.clientY];plateSwipe=false});
plate.addEventListener('pointerup',e=>{
  if(!pDown)return;
  const dx=e.clientX-pDown[0],dy=e.clientY-pDown[1];pDown=null;
  if(Math.abs(dx)>48&&Math.abs(dx)>Math.abs(dy)*1.3){
    plateSwipe=true;setTimeout(()=>plateSwipe=false,350);
    nav(dx<0?1:-1);
  }
});
plate.addEventListener('click',e=>{
  if(plateSwipe||e.target.closest('.mNav'))return;
  openLB(galIdx);
});
plate.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' ')openLB(galIdx)});
if(FINE&&!RM){
  plate.addEventListener('mousemove',e=>{
    const r=plate.getBoundingClientRect();
    const x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
    plate.style.setProperty('--ry',(x*3).toFixed(2)+'deg');
    plate.style.setProperty('--rx',(-y*2.4).toFixed(2)+'deg');
  });
  plate.addEventListener('mouseleave',()=>{
    plate.style.setProperty('--ry','0deg');plate.style.setProperty('--rx','0deg');
  });
}
let lbP=null;
lb.addEventListener('pointerdown',e=>{if(e.target.closest('button'))return;lbP=[e.clientX,e.clientY]});
lb.addEventListener('pointerup',e=>{
  if(!lbP)return;const dx=e.clientX-lbP[0];lbP=null;
  if(dx<-45)lbNav(1);else if(dx>45)lbNav(-1);
});

/* اسکرول کاروسل: چرخ موس + درگ با موس */
const strip=$('galStrip');
strip.addEventListener('wheel',e=>{
  if(Math.abs(e.deltaY)>Math.abs(e.deltaX)){e.preventDefault();strip.scrollLeft-=e.deltaY}
},{passive:false});
let sDrag=null;
strip.addEventListener('pointerdown',e=>{
  if(e.pointerType!=='mouse')return;
  sDrag={x:e.clientX,sl:strip.scrollLeft};
  strip.style.scrollBehavior='auto';
});
addEventListener('pointermove',e=>{
  if(!sDrag)return;
  strip.scrollLeft=sDrag.sl-(e.clientX-sDrag.x);
});
addEventListener('pointerup',()=>{
  if(!sDrag)return;
  sDrag=null;strip.style.scrollBehavior='';
});

/* جست‌وجو */
 $('q').addEventListener('input',e=>{
  query=e.target.value;
  $('qClear').style.display=query?'':'none';
  refresh();
});
 $('qClear').addEventListener('click',()=>{
  query='';$('q').value='';$('qClear').style.display='none';refresh();
});

/* دریافت دوبارهٔ تصاویر آرشیوی */
 $('galRetry').addEventListener('click',()=>{
  if(!cur)return;
  cacheDel(imgKey(cur.id));cacheDel(galKey(cur.id));
  const b=$('galRetry');b.classList.add('spin');
  setTimeout(()=>b.classList.remove('spin'),1100);
  mainShown=null;sync();
});

/* ═══════════ ۱۳) راه‌اندازی ═══════════ */
buildChips();
order=[...UAVS];
cur=UAVS[0];
buildTicks();sync(true);
 $('capMin').textContent='کوچک‌ترین: '+sizeFa(UAVS[0]);
 $('capMax').textContent='بزرگ‌ترین: '+sizeFa(UAVS[UAVS.length-1]);

function finishIntro(){
  if(document.body.classList.contains('ready'))return;
  $('splash').classList.add('gone');
  document.body.classList.add('ready');
  setTimeout(()=>{const s=$('splash');if(s)s.remove()},900);
}
setTimeout(finishIntro,1150);
 $('splash').addEventListener('click',finishIntro);
