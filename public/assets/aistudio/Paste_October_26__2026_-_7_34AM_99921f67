    const p=[iso(i,j),iso(i+1,j),iso(i+1,j+1),iso(i,j+1)];
    const fill=road?'#232912':park?'#2a3a19':((i+j)%2?'#1f250f':'#1c220d');
    rows.push('<polygon points="'+pp(p)+'" fill="'+fill+'" stroke="rgba(0,0,0,.16)" stroke-width=".5"/>');
    if(park){
      const c=iso(i+.5,j+.5);
      const trees=2+Math.floor(Math.random()*3);
      for(let t=0;t<trees;t++){
        const ox=(Math.random()-.5)*22,oy=(Math.random()-.5)*10;
        rows.push('<ellipse cx="'+(c[0]+ox).toFixed(1)+'" cy="'+(c[1]+oy).toFixed(1)+'" rx="3.2" ry="2" fill="#3c5520"/>');
      }
    }
  }
  // خط‌کشی جاده‌ها
  const ln=(a,b)=>rows.push('<line x1="'+a[0]+'" y1="'+a[1]+'" x2="'+b[0]+'" y2="'+b[1]+'" stroke="#3a4322" stroke-width="1.1" stroke-dasharray="5 7"/>');
  ln(iso(4.5,0),iso(4.5,GY));ln(iso(9.5,0),iso(9.5,GY));
  ln(iso(0,3.5),iso(GX,3.5));ln(iso(0,7.5),iso(GX,7.5));
  // ساختمان‌ها
  const bs=[];
  for(let i=0;i<GX;i++)for(let j=0;j<GY;j++){
    if(isRoad(i,j)||parks.has(i+','+j))continue;
    if(Math.random()<.13)continue;
    const w=.42+Math.random()*.34,d=.42+Math.random()*.34;
    const i0=i+(1-w)/2,j0=j+(1-d)/2,i1=i0+w,j1=j0+d;
    const r=Math.random();
    const h=r<.5?7+Math.random()*13:r<.85?17+Math.random()*20:32+Math.random()*32;
    bs.push({x:(i0+i1)/2,y:(j0+j1)/2,i0,j0,i1,j1,h,t:Math.random()});
  }
  bs.sort((a,b)=>(a.x+a.y)-(b.x+b.y));
  for(const b of bs){
    const A=iso(b.i0,b.j0),B=iso(b.i1,b.j0),C=iso(b.i1,b.j1),D=iso(b.i0,b.j1);
    const h=b.h,hue=72+Math.round(b.t*14),sat=12+Math.round(b.t*10);
    const lt=Math.min(38,26+h*.14);
    const top='hsl('+hue+' '+sat+'% '+Math.round(lt+8)+'%)';
    const right='hsl('+hue+' '+(sat+4)+'% '+Math.round(lt-5)+'%)';
    const left='hsl('+hue+' '+sat+'% '+Math.round(lt-12)+'%)';
    rows.push('<g class="bld" data-x="'+b.x.toFixed(2)+'" data-y="'+b.y.toFixed(2)+'">'
      +'<polygon points="'+D[0]+','+(D[1]-h)+' '+C[0]+','+(C[1]-h)+' '+C[0]+','+C[1]+' '+D[0]+','+D[1]+'" fill="'+left+'"/>'
      +'<polygon points="'+B[0]+','+(B[1]-h)+' '+C[0]+','+(C[1]-h)+' '+C[0]+','+C[1]+' '+B[0]+','+B[1]+'" fill="'+right+'"/>'
      +'<polygon points="'+A[0]+','+(A[1]-h)+' '+B[0]+','+(B[1]-h)+' '+C[0]+','+(C[1]-h)+' '+D[0]+','+(D[1]-h)+'" fill="'+top+'" stroke="rgba(0,0,0,.18)" stroke-width=".4"/>'
      +'</g>');
  }
  $('#city').innerHTML=rows.join('');
}

function updateMarker(){
  const c=iso(target.i,target.j);
  $('#marker').setAttribute('transform','translate('+c[0].toFixed(1)+' '+c[1].toFixed(1)+')');
}
function clearFx(){
  $('#rings').innerHTML='';$('#fx').innerHTML='';$('#labels').innerHTML='';
  $$('#city .bld').forEach(g=>g.classList.remove('ruined','damaged'));
}
function rebuildCity(){renderCity();clearFx();toast('شهرک تازه‌ای ساخته شد');}

/* ================= صدای سنتزشده (Web Audio) ================= */
let AC=null,master=null,muted=false;
function actx(){
  if(!AC){const C=window.AudioContext||window.webkitAudioContext;if(!C)return null;
    AC=new C();master=AC.createGain();master.gain.value=.85;master.connect(AC.destination);}
  if(AC.state==='suspended')AC.resume();
  return AC;
}
function boom(tier){
  if(muted)return;const ctx=actx();if(!ctx)return;
  const t=ctx.currentTime,dur=1.1+tier*.5;
  const n=Math.floor(ctx.sampleRate*dur),buf=ctx.createBuffer(1,n,ctx.sampleRate),d=buf.getChannelData(0);
  let l=0;
  for(let i=0;i<n;i++){const w=Math.random()*2-1;l=l*.965+w*.035;d[i]=l*3.4*Math.pow(1-i/n,1.8);}
  const src=ctx.createBufferSource();src.buffer=buf;
  const lp=ctx.createBiquadFilter();lp.type='lowpass';
  lp.frequency.setValueAtTime(Math.max(400,1500-160*tier),t);
  lp.frequency.exponentialRampToValueAtTime(55,t+dur);
  const g=ctx.createGain();g.gain.setValueAtTime(.5+tier*.09,t);
  g.gain.exponentialRampToValueAtTime(.001,t+dur);
  src.connect(lp);lp.connect(g);g.connect(master);src.start(t);
  const o=ctx.createOscillator();o.type='sine';
  o.frequency.setValueAtTime(95-6*tier,t);o.frequency.exponentialRampToValueAtTime(26,t+1.5);
  const og=ctx.createGain();og.gain.setValueAtTime(.0001,t);
  og.gain.exponentialRampToValueAtTime(.55,t+.05);og.gain.exponentialRampToValueAtTime(.0001,t+1.8);
  o.connect(og);og.connect(master);o.start(t);o.stop(t+1.9);
}
function tick(){
  if(muted)return;const ctx=actx();if(!ctx)return;
  const t=ctx.currentTime,o=ctx.createOscillator(),g=ctx.createGain();
  o.type='triangle';o.frequency.setValueAtTime(640,t);o.frequency.exponentialRampToValueAtTime(420,t+.07);
  g.gain.setValueAtTime(.055,t);g.gain.exponentialRampToValueAtTime(.0001,t+.09);
  o.connect(g);g.connect(master);o.start(t);o.stop(t+.1);
}
function toggleMute(){muted=!muted;$('#sndBtn').classList.toggle('muted',muted);
  toast(muted?'صدا: خاموش':'صدا: روشن');}

/* ================= انفجار ================= */
let animId=null,current=null;
function detonate(){
  const b=current;if(!b)return;
  if(animId){cancelAnimationFrame(animId);animId=null;}
  clearFx();
  $('#mapHint').classList.add('seen');
  const mPer=b.severe/7;                       // متر در هر بلوک — طوری که شعاع «شدید» در نقشه جا شود
  const c0=iso(target.i,target.j),cx=c0[0],cy=c0[1];
  const fT=b.full/mPer,sT=b.severe/mPer,nT=b.sound/mPer;
  const KX=TW/2*Math.SQRT2,KY=TH/2*Math.SQRT2; // تبدیل شعاع شبکه‌ای به بیضی ایزومتریک
  const tier=b.tier,dur=1900+tier*430;
  const rings=$('#rings');
  const mkE=(cls,fill)=>{const e=document.createElementNS(NS,'ellipse');
    e.setAttribute('cx',cx);e.setAttribute('cy',cy);e.setAttribute('rx',0);e.setAttribute('ry',0);
    if(cls)e.setAttribute('class',cls);if(fill)e.setAttribute('fill',fill);
    rings.appendChild(e);return e;};
  const shock=mkE('shock');
  const sh2=tier>=3?mkE('shock2'):null, sh3=tier>=4?mkE('shock2'):null;
  const fire=mkE('fire','url(#gFlash)');
  const fullF=mkE('fullfill'),sevE=mkE('sevr'),sndE=mkE('sndr');
  const scor=document.createElementNS(NS,'ellipse');
  scor.setAttribute('cx',cx);scor.setAttribute('cy',cy);scor.setAttribute('fill','rgba(6,8,3,.62)');
  $('#fx').appendChild(scor);
  const blds=$$('#city .bld').map(g=>({g,d:Math.hypot(+g.dataset.x-target.i,+g.dataset.y-target.j)}))
    .sort((a,b)=>a.d-b.d);
  let ptr=0;
  const setR=(e,r)=>{e.setAttribute('rx',(r*KX).toFixed(1));e.setAttribute('ry',(r*KY).toFixed(1));};
  boom(tier);
  const sv=$('#stageView');sv.classList.remove('boom');void sv.offsetWidth;sv.classList.add('boom');
  if(tier>=2){
    const st=$('#stagePanel');st.classList.remove('shake');void st.offsetWidth;
    st.style.setProperty('--mag',(1.4+tier*1.1).toFixed(1)+'px');st.classList.add('shake');
  }
  const t0=performance.now();
  const frame=now=>{
    const p=Math.min(1,(now-t0)/dur);
    const front=(p/.55)*sT; // جبههٔ موج شوک — پیشروی خطی (فیزیکی)
    setR(shock,Math.min(front,sT));
    shock.style.opacity=Math.max(0,.95-(p/.55)*.85).toFixed(2);
    if(sh2){setR(sh2,Math.max(0,front-sT*.3));sh2.style.opacity=Math.max(0,.7-(p/.6)*.8).toFixed(2);}
    if(sh3){setR(sh3,Math.max(0,front-sT*.55));sh3.style.opacity=Math.max(0,.55-(p/.65)*.7).toFixed(2);}
    const fr=fT*.55;
    setR(fire,p<.4?fr*Math.min(1,p*6):fr);
    fire.style.opacity=p<.12?'.95':Math.max(0,.95-(p-.12)*2.1).toFixed(2);
    setR(fullF,Math.min(front,fT));
    setR(sevE,Math.min(front,sT));
    setR(sndE,Math.min(p/.9,1)*nT);
    sndE.style.opacity=(.45-.3*Math.min(p/.9,1)).toFixed(2);
    const sr=fT*.45*Math.min(1,p*4);
    scor.setAttribute('rx',(sr*KX).toFixed(1));scor.setAttribute('ry',(sr*KY).toFixed(1));
    const rM=front*mPer; // شعاع جبهه به متر
    while(ptr<blds.length&&blds[ptr].d*mPer<=rM){
      const it=blds[ptr++];it.g.classList.add(it.d<=fT?'ruined':'damaged');
    }
    if(p<1){animId=requestAnimationFrame(frame);}
    else{
      animId=null;addLabels(b,cx,cy,fT,sT,nT);
      if(tier>=3)toast('گزارش: «'+b.fa+'» — تخریب کامل در شعاع '+fmtLen(b.full));
    }
  };
  animId=requestAnimationFrame(frame);
}
function addLabels(b,cx,cy,fT,sT,nT){
  const L=$('#labels');L.innerHTML='';
  const put=(d,txt,color)=>{if(d<=0)return;
    const y=Math.max(48,cy-d*14.14-9);
    const t=document.createElementNS(NS,'text');
    t.setAttribute('x',cx);t.setAttribute('y',y);t.setAttribute('text-anchor','middle');t.setAttribute('fill',color);
    t.textContent=txt;L.appendChild(t);};
  put(fT,'تخریب کامل ≈ '+fmtR(b.full),'#ff9c6b');
  put(sT,'آسیب شدید ≈ '+fmtR(b.severe),'#ffcf9a');
  if(nT<=10)put(nT,'برد صدا ≈ '+fmtR(b.sound),'#b9c193');
}

/* ================= فهرست و انتخاب ================= */
function miniGlyph(b){
  const s=b.tier;
  return '<svg class="glyph" viewBox="0 0 44 26" aria-hidden="true">'
    +'<polygon points="22,2 42,13 22,24 2,13" fill="rgba(198,214,120,.05)" stroke="rgba(213,224,160,.25)"/>'
    +'<ellipse cx="22" cy="13" rx="'+(5+s*1.6)+'" ry="'+(2.5+s*.8)+'" fill="none" stroke="#ff5a2e" stroke-opacity=".85"/>'
    +'<ellipse cx="22" cy="13" rx="'+(3+s)+'" ry="'+(1.5+s*.5)+'" fill="none" stroke="#ffb35c" stroke-opacity=".7"/>'
    +'<circle cx="22" cy="13" r="1.4" fill="#ffd9a8"/></svg>';
}
function renderList(){
  $('#bombList').innerHTML=BOMBS.map((b,ix)=>
    '<div class="bomb" data-id="'+b.id+'" tabindex="0" role="button" aria-pressed="false">'
    +'<span class="idx">'+faNum(String(ix+1).padStart(2,'0'))+'</span>'
    +miniGlyph(b)
    +'<span class="bmeta"><b class="en">'+b.en+'</b><i>'+b.fa+'</i><small>'+b.sub+'</small></span>'
    +'<span class="bpower">'+b.yShort+'</span>'
    +'<button class="cmp" data-id="'+b.id+'" aria-label="افزودن به مقایسه">'+IC.plus+'</button>'
    +'</div>').join('');
}
function renderInfo(b){
  const P=$('#infoPanel');
  P.innerHTML=
   '<div class="info-top"><div><div class="info-kicker">شناسنامهٔ مهمات</div>'
   +'<h2><span class="en">'+b.en+'</span><span class="faName">'+b.fa+'</span></h2></div>'
   +'<div class="info-chips">'
   +'<span class="chip"><i class="flag '+b.flag+'"></i>'+b.country+'</span>'
   +'<span class="chip">'+b.cls+'</span>'
   +'<span class="chip">'+b.years+'</span></div></div>'
   +'<div class="info-grid">'
   +'<div class="tile"><label>مادهٔ منفجره</label><b>'+b.expl+'</b></div>'
   +'<div class="tile"><label>وزن کل</label><b>'+b.weight+'</b></div>'
   +'<div class="tile"><label>معادل انرژی</label><b>'+b.yieldTxt+'</b><small>'+ratioText(b.y/0.089)+'</small></div>'
   +'<div class="tile wide"><label>شعاع‌های اثر (تقریبی)</label>'
   +barRow('تخریب کامل',b.full,'#ff5a2e')
   +barRow('آسیب شدید',b.severe,'#ffb35c')
   +barRow('برد صدا',b.sound,'#aab287')
   +'</div></div>'
   +'<p class="desc">'+b.desc+'</p>'
   +'<ul class="facts">'+b.facts.map(f=>'<li>'+f+'</li>').join('')+'</ul>';
  P.classList.remove('in');void P.offsetWidth;P.classList.add('in');
}
function select(id,opts){
  opts=opts||{};
  const b=BOMBS.find(x=>x.id===id);if(!b)return;
  current=b;
  $$('.bomb').forEach(el=>{
    const on=el.dataset.id===id;
    el.classList.toggle('active',on);el.setAttribute('aria-pressed',on);
  });
  renderInfo(b);
  $('#scaleChip').textContent='مقیاس: هر بلوک ≈ '+fmtLen(b.severe/7);
  if(opts.fire!==false){tick();detonate();}else{clearFx();}
}
function step(dir){
  const idx=BOMBS.indexOf(current);
  const n=(idx+dir+BOMBS.length)%BOMBS.length;
  select(BOMBS[n].id);
}

/* ================= مقایسه ================= */
const cmp=[];
function toggleCmp(id){
  const i=cmp.indexOf(id);
  if(i>=0){cmp.splice(i,1);}
  else{
    if(cmp.length>=2){toast('در هر لحظه حداکثر دو بمب قابل مقایسه است');return;}
    cmp.push(id);tick();
  }
  $$('.cmp').forEach(b=>{
    const on=cmp.includes(b.dataset.id);
    b.classList.toggle('on',on);b.innerHTML=on?IC.check:IC.plus;
    b.setAttribute('aria-label',on?'حذف از مقایسه':'افزودن به مقایسه');
  });
  if(cmp.length===1)toast('برای مقایسه، بمب دوم را هم انتخاب کنید');
  renderCmp();$('#cmpDrawer').classList.add('open');
}
function renderCmp(){
  const body=$('#cmpBody');
  if(!cmp.length){
    body.innerHTML='<p class="cmp-empty">برای مقایسه، روی آیکن <b>+</b> در کارت هر بمب بزنید؛ تا دو بمب را هم‌زمان می‌توانید بسنجید.</p>';
    return;
  }
  const bs=cmp.map(id=>BOMBS.find(b=>b.id===id));
  body.innerHTML='<div class="cmp-cols">'+bs.map(b=>
    '<div class="cmp-col">'
    +'<h4><i class="flag '+b.flag+'"></i><span class="en">'+b.en+'</span><em>'+b.fa+'</em></h4>'
    +'<div class="cr"><span>کشور سازنده</span><b>'+b.country+'</b></div>'
    +'<div class="cr"><span>سال‌های استفاده</span><b>'+b.years+'</b></div>'
    +'<div class="cr"><span>معادل انرژی</span><b>'+b.yieldTxt+'</b></div>'
    +'<div class="cr"><span>وزن کل</span><b>'+b.weight+'</b></div>'
    +barRow('تخریب کامل',b.full)
    +barRow('آسیب شدید',b.severe,'#ffb35c')
    +barRow('برد صدا',b.sound,'#aab287')
    +'</div>').join('')+'</div>'
    +(bs.length<2?'<p class="cmp-note">یک بمب دیگر برای مقایسه انتخاب کنید…</p>':'');
}

/* ================= حالت ارائه ================= */
function setPresent(on){
  document.documentElement.classList.toggle('present',on);
  $('#presentLbl').textContent=on?'خروج از حالت ارائه':'حالت ارائه';
  if(on){
    try{if(document.documentElement.requestFullscreen)document.documentElement.requestFullscreen().catch(()=>{});}catch(e){}
    toast('حالت ارائه فعال شد — با Esc خارج شوید');
  }else{
    try{if(document.fullscreenElement)document.exitFullscreen().catch(()=>{});}catch(e){}
  }
}

/* ================= رویدادها ================= */
 $('#bombList').addEventListener('click',e=>{
  const cmpBtn=e.target.closest('.cmp');
  if(cmpBtn){e.stopPropagation();toggleCmp(cmpBtn.dataset.id);return;}
  const c=e.target.closest('.bomb');
  if(c)select(c.dataset.id);
});
 $('#bombList').addEventListener('keydown',e=>{
  const c=e.target.closest('.bomb');if(!c)return;
  if(e.key==='Enter'||e.key===' '){e.preventDefault();e.stopPropagation();select(c.dataset.id);}
});
 $('#map').addEventListener('click',e=>{
  const m=$('#map').getScreenCTM();if(!m)return;
  const p=new DOMPoint(e.clientX,e.clientY).matrixTransform(m.inverse());
  const dx=(p.x-OX)/(TW/2),dy=(p.y-OY)/(TH/2);
  let i=(dx+dy)/2,j=(dy-dx)/2;
  i=Math.min(GX-.3,Math.max(.3,i));j=Math.min(GY-.3,Math.max(.3,j));
  target={i:i,j:j};updateMarker();detonate();
});
 $('#fireBtn').addEventListener('click',()=>detonate());
 $('#rebuildBtn').addEventListener('click',rebuildCity);
 $('#sndBtn').addEventListener('click',toggleMute);
 $('#prevB').addEventListener('click',()=>step(-1));
 $('#nextB').addEventListener('click',()=>step(1));
 $('#presentBtn').addEventListener('click',()=>setPresent(!document.documentElement.classList.contains('present')));
 $('#compareBtn').addEventListener('click',()=>$('#cmpDrawer').classList.toggle('open'));
 $('#cmpClose').addEventListener('click',()=>$('#cmpDrawer').classList.remove('open'));
 $('#cmpClear').addEventListener('click',()=>{
  cmp.length=0;
  $$('.cmp').forEach(b=>{b.classList.remove('on');b.innerHTML=IC.plus;});
  renderCmp();
});
document.addEventListener('keydown',e=>{
  const t=e.target;
  if(t&&(t.tagName==='INPUT'||t.tagName==='TEXTAREA'||t.isContentEditable))return;
  if(e.key===' '){
    if(t&&t.closest&&t.closest('button'))return;
    e.preventDefault();detonate();
  }
  else if(e.key==='ArrowDown'){e.preventDefault();step(1);}
  else if(e.key==='ArrowUp'){e.preventDefault();step(-1);}
  else if(e.key==='p'||e.key==='P'){setPresent(!document.documentElement.classList.contains('present'));}
  else if(e.key==='m'||e.key==='M'){toggleMute();}
  else if(e.key==='r'||e.key==='R'){rebuildCity();}
  else if(e.key==='Escape'){
    if(document.documentElement.classList.contains('present'))setPresent(false);
    else $('#cmpDrawer').classList.remove('open');
  }
});

/* ================= شروع ================= */
renderList();
renderCity();
updateMarker();
select('mk82',{fire:false});
renderCmp();
})();
</script>
